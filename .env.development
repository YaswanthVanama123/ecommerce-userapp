# Development Environment Variables
# For local development only

# API Configuration
# Using relative path to leverage Vite proxy - avoids CORS issues
VITE_API_URL=/api
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=ValidateSharing Dev
VITE_APP_VERSION=1.0.0-dev
VITE_APP_ENV=development

# Feature Flags - All enabled for development
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_DEBUG_MODE=true

# Performance Configuration
VITE_ENABLE_SERVICE_WORKER=false
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_LAZY_LOADING=true
VITE_PREFETCH_TIMEOUT=2000

# CDN Configuration (not used in development)
VITE_CDN_URL=
VITE_STATIC_ASSETS_URL=

# Analytics (disabled in development)
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# Security
VITE_ENABLE_HTTPS=false
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cache Configuration
VITE_CACHE_VERSION=1.0.0-dev
VITE_ENABLE_HTTP_CACHE=false

# Image Optimization
VITE_IMAGE_QUALITY=80
VITE_ENABLE_WEBP=false
VITE_ENABLE_LAZY_IMAGES=true

# Rate Limiting
VITE_API_RATE_LIMIT=100
VITE_API_RATE_WINDOW=60000

# Session Configuration
VITE_SESSION_TIMEOUT=1800000
VITE_REMEMBER_ME_DURATION=2592000000
