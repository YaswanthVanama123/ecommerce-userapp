  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#667eea",
  "background_color": "#ffffff",
  "categories": ["shopping", "lifestyle", "business"],
  "lang": "en-US",
  "dir": "ltr",
