# Production Environment Variables - Example
# Copy this to .env.production and fill in your actual values
# WARNING: Never commit .env.production to version control!

# ================================
# API Configuration (REQUIRED)
# ================================
VITE_API_URL=https://api.yourdomain.com/api
VITE_API_TIMEOUT=30000

# ================================
# Application Configuration
# ================================
VITE_APP_NAME=ValidateSharing
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# ================================
# Feature Flags
# ================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_DEBUG_MODE=false

# ================================
# Performance Configuration
# ================================
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_LAZY_LOADING=true
VITE_PREFETCH_TIMEOUT=2000

# ================================
# CDN Configuration (Optional)
# ================================
# If using a CDN, specify the URLs here
VITE_CDN_URL=https://cdn.yourdomain.com
VITE_STATIC_ASSETS_URL=https://static.yourdomain.com

# ================================
# Analytics & Monitoring
# ================================
# Google Analytics 4 Tracking ID
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN for error reporting
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx

# Custom analytics endpoint (optional)
VITE_ANALYTICS_ENDPOINT=https://analytics.yourdomain.com/track

# Custom error reporting endpoint (optional)
VITE_ERROR_REPORTING_ENDPOINT=https://errors.yourdomain.com/report

# ================================
# Security Configuration
# ================================
VITE_ENABLE_HTTPS=true
VITE_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ================================
# Cache Configuration
# ================================
VITE_CACHE_VERSION=1.0.0
VITE_ENABLE_HTTP_CACHE=true

# ================================
# Image Optimization
# ================================
VITE_IMAGE_QUALITY=80
VITE_ENABLE_WEBP=true
VITE_ENABLE_LAZY_IMAGES=true

# ================================
# Rate Limiting
# ================================
VITE_API_RATE_LIMIT=100
VITE_API_RATE_WINDOW=60000

# ================================
# Session Configuration
# ================================
# Session timeout: 30 minutes (1800000ms)
VITE_SESSION_TIMEOUT=1800000

# Remember me duration: 30 days (2592000000ms)
VITE_REMEMBER_ME_DURATION=2592000000

# ================================
# Setup Instructions
# ================================
# 1. Copy this file: cp .env.production.example .env.production
# 2. Replace all placeholder values with your actual configuration
# 3. Update VITE_API_URL with your production API endpoint
# 4. Add your analytics IDs (Google Analytics, Sentry, etc.)
# 5. Configure CDN URLs if using a CDN
# 6. Never commit .env.production to version control!
# 7. Add .env.production to .gitignore (should already be there)
